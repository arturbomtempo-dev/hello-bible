{
    "name": "hello-bible",
    "displayName": "Hello Bible",
    "description": "A simple VS Code extension that displays a daily Bible verse.",
    "version": "0.0.5",
    "repository": {
        "type": "git",
        "url": "https://github.com/arturbcolen/hello-bible"
    },
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "hello-bible.showVerse",
                "title": "Bible: Show Verse"
            },
            {
                "command": "hello-bible.showFavorites",
                "title": "Bible: Show Favorite Verses",
                "icon": "media/book.svg"
            }
        ],
        "views": {
            "explorer": [
                {
                    "type": "webview",
                    "id": "hello-bible.view",
                    "name": "Hello Bible",
                    "icon": "media/book.svg",
                    "visibility": "collapsed"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "hello-bible.showFavorites",
                    "when": "view == hello-bible.view",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vitest",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/vscode": "^1.125.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "eslint": "^10.5.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    }
}
